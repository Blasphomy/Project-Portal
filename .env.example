# ============================================
# AI-Powered Learning Platform - Environment Configuration
# ============================================

# Database Configuration
# Get your Supabase connection string from: https://supabase.com → Project Settings → Database
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres

# AI Service Configuration
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
# Leave empty to use hardcoded test data (recommended for first run)
GEMINI_API_KEY=

# JWT Configuration
# This secret is used to sign authentication tokens
# Generate a secure random string or leave empty for auto-generation
JWT_SECRET=your-secure-jwt-secret-here

# PostgreSQL Local (Optional - if using local database instead of Supabase)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=learning_db

# Redis Configuration (Auto-configured via Docker Compose)
# REDIS_HOST=redis
# REDIS_PORT=6379

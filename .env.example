# Environment Variables Template
# ===========================================
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env (it's in .gitignore)
# ===========================================

# ===========================================
# DATABASE
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres  # <-- CHANGE IN PRODUCTION!
POSTGRES_DB=learning_db

# ===========================================
# SECURITY
# ===========================================

# JWT Secret (MUST be 64+ characters in production)
# Development: Can use default below
# Production: Generate with: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-please-make-it-long-enough-for-HS256

# ===========================================
# AI SERVICES - REQUIRED
# ===========================================

# Google Gemini API Key (REQUIRED for AI features to work)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# AI SERVICES - OPTIONAL (Advanced Features)
# ===========================================

# Pinecone Vector Database (for semantic search)
# Only needed if you're using vector similarity search
# Get from: https://www.pinecone.io/
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_ENVIRONMENT=us-east-1

# Cohere (for text embeddings)
# Only needed if you're using Cohere embeddings
# Get from: https://cohere.ai/
# COHERE_API_KEY=your_cohere_api_key

# ===========================================
# MONITORING - OPTIONAL
# ===========================================

# Grafana admin password (only if using monitoring stack)
# GRAFANA_ADMIN_PASSWORD=admin123

# ===========================================
# DEPLOYMENT - OPTIONAL
# ===========================================

# Spring profile (local or docker)
# Default is 'local' for development
# For Docker deployment, set to 'docker'
# SPRING_PROFILES_ACTIVE=docker

# JVM settings (for production tuning)
# JAVA_OPTS=-Xms512m -Xmx2g

# ===========================================
# NOTES FOR PRODUCTION:
# ===========================================
# 1. Use strong, random values for POSTGRES_PASSWORD and JWT_SECRET
# 2. Never use default passwords in production
# 3. Store .env securely, never commit it to git
# 4. Consider using a secrets manager (AWS Secrets Manager, etc.)
# 5. Set SPRING_PROFILES_ACTIVE=docker for containerized deployment

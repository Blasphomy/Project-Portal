<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-1" author="system">
        <comment>Seed initial topics</comment>
        <insert tableName="topics">
            <column name="id" value="topic-java-101"/>
            <column name="name" value="Java Fundamentals"/>
            <column name="description" value="Master the basics of Java programming"/>
            <column name="difficulty_level" value="beginner"/>
            <column name="estimated_hours" value="20"/>
            <column name="category" value="programming"/>
        </insert>
        <insert tableName="topics">
            <column name="id" value="topic-java-102"/>
            <column name="name" value="Spring Boot"/>
            <column name="description" value="Build modern web applications with Spring Boot"/>
            <column name="difficulty_level" value="intermediate"/>
            <column name="estimated_hours" value="30"/>
            <column name="category" value="framework"/>
            <column name="prerequisites" value='["Java Fundamentals"]'/>
        </insert>
        <insert tableName="topics">
            <column name="id" value="topic-db-101"/>
            <column name="name" value="SQL &amp; Databases"/>
            <column name="description" value="Learn relational databases and SQL"/>
            <column name="difficulty_level" value="beginner"/>
            <column name="estimated_hours" value="15"/>
            <column name="category" value="database"/>
        </insert>
    </changeSet>

    <changeSet id="004-2" author="system">
        <comment>Seed sample quests</comment>
        <insert tableName="quests">
            <column name="id" value="quest-1"/>
            <column name="topic_id" value="topic-java-101"/>
            <column name="name" value="Variables &amp; Data Types"/>
            <column name="description" value="Learn about variables, primitive types, and type casting"/>
            <column name="sequence_order" value="1"/>
            <column name="difficulty" value="beginner"/>
            <column name="estimated_minutes" value="60"/>
        </insert>
        <insert tableName="quests">
            <column name="id" value="quest-2"/>
            <column name="topic_id" value="topic-java-101"/>
            <column name="name" value="Control Flow"/>
            <column name="description" value="Master if statements, loops, and switch cases"/>
            <column name="sequence_order" value="2"/>
            <column name="difficulty" value="beginner"/>
            <column name="estimated_minutes" value="90"/>
        </insert>
    </changeSet>

    <changeSet id="004-3" author="system">
        <comment>Seed sample tasks</comment>
        <insert tableName="tasks">
            <column name="id" value="task-1"/>
            <column name="quest_id" value="quest-1"/>
            <column name="title" value="Declare Your First Variable"/>
            <column name="description" value="Create an integer variable and assign it a value"/>
            <column name="xp_reward" value="10"/>
            <column name="sequence_order" value="1"/>
            <column name="has_code_challenge" valueBoolean="true"/>
            <column name="starter_code" value="// Declare an integer variable named 'age' and assign it your age"/>
            <column name="difficulty" value="beginner"/>
        </insert>
        <insert tableName="tasks">
            <column name="id" value="task-2"/>
            <column name="quest_id" value="quest-1"/>
            <column name="title" value="String Concatenation"/>
            <column name="description" value="Combine strings using the + operator"/>
            <column name="xp_reward" value="15"/>
            <column name="sequence_order" value="2"/>
            <column name="has_code_challenge" valueBoolean="true"/>
            <column name="starter_code" value="String firstName = &quot;John&quot;;&#10;String lastName = &quot;Doe&quot;;&#10;// Create fullName by concatenating firstName and lastName"/>
            <column name="difficulty" value="beginner"/>
        </insert>
    </changeSet>

    <changeSet id="004-4" author="system">
        <comment>Seed sample badges</comment>
        <insert tableName="badges">
            <column name="id" value="badge-first-step"/>
            <column name="name" value="First Steps"/>
            <column name="description" value="Complete your first task"/>
            <column name="requirement_type" value="tasks_completed"/>
            <column name="requirement_value" value="1"/>
            <column name="tier" value="bronze"/>
        </insert>
        <insert tableName="badges">
            <column name="id" value="badge-java-novice"/>
            <column name="name" value="Java Novice"/>
            <column name="description" value="Complete 10 Java tasks"/>
            <column name="requirement_type" value="tasks_completed"/>
            <column name="requirement_value" value="10"/>
            <column name="tier" value="silver"/>
        </insert>
        <insert tableName="badges">
            <column name="id" value="badge-xp-hunter"/>
            <column name="name" value="XP Hunter"/>
            <column name="description" value="Earn 1000 XP"/>
            <column name="requirement_type" value="total_xp"/>
            <column name="requirement_value" value="1000"/>
            <column name="tier" value="gold"/>
        </insert>
    </changeSet>

</databaseChangeLog>

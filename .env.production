# Production Environment Configuration
# Copy this to .env on production server and fill in real values

# ============================================
# Security - CHANGE ALL OF THESE!
# ============================================

# Generate strong JWT secret (64+ characters)
# Run: openssl rand -base64 64
JWT_

# Strong database password
# Run: openssl rand -base64 32
POSTGRES_PASSWORD=postgres

# ============================================
# API Keys
# ============================================

# Google Gemini API Key (required)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCNK2MvSHBDkgVX697vwRwX8QxL0kPA5zA

# ============================================
# Database Configuration
# ============================================

POSTGRES_USER=postgres

# User Service Database
USER_DB_HOST=postgres-user
USER_DB_PORT=5432
USER_DB_NAME=userdb

# Learning Service Database
LEARNING_DB_HOST=postgres-learning
LEARNING_DB_PORT=5432
LEARNING_DB_NAME=learningdb

# ============================================
# Service URLs (Internal Docker Network)
# ============================================

USER_SERVICE_URL=http://user-service:8081
LEARNING_SERVICE_URL=http://learning-service:8082
AI_SERVICE_URL=http://ai-service:8083

# ============================================
# Frontend Configuration
# ============================================

# Production API URL (change to your domain)
REACT_APP_API_URL=https://api.yourdomain.com

# ============================================
# Optional: Monitoring & Logging
# ============================================

# Enable production mode
SPRING_PROFILES_ACTIVE=prod

# Log level (ERROR, WARN, INFO, DEBUG)
LOGGING_LEVEL_ROOT=INFO

# ============================================
# Optional: Performance Tuning
# ============================================

# JVM Heap Size
JAVA_OPTS=-Xms512m -Xmx2g

# Database Connection Pool
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5

# ============================================
# Optional: Email Configuration (if needed)
# ============================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================
# Backup Configuration
# ============================================

BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/var/backups/learning-platform

# Optional: S3 Backup
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BACKUP_BUCKET=your-backup-bucket
